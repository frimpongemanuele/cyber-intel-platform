# Copy to .env next to compose.yaml and adjust. No secrets here: those are files in
# deploy/secrets/ (deploy/scripts/make-secrets.sh).

# Host name(s) the dashboard answers to (comma-separated). Use your Tailscale name, and
# keep 127.0.0.1: requests forwarded by `tailscale serve` can arrive with that host name
# (the dashboard port is loopback-only, so allowing it exposes nothing). Add "localhost"
# if you use deploy/compose.localhost.example.yaml.
CIT_WEB_ALLOWED_HOSTS=cit.example.ts.net,127.0.0.1
# Served through `tailscale serve` (HTTPS), so keep secure cookies and HSTS on.
CIT_WEB_HSTS=1
CIT_WEB_INSECURE_COOKIES=0

# Where nightly dumps go (mount your Proxmox Backup Server / NAS share here).
CIT_BACKUP_DIR=./backups
CIT_BACKUP_KEEP_DAYS=14

# Optional AI layer (docs/AI.md). Off unless you start the `ai` profile and set a provider.
CIT_AI_PROVIDER=none
CIT_AI_MODEL=
# local model:  CIT_AI_PROVIDER=ollama  CIT_AI_OLLAMA_URL=http://ollama:11434 (profile ollama)
# hosted API:   CIT_AI_PROVIDER=anthropic  CIT_AI_PROXY=http://egress:3129  + deploy/secrets/ai_api_key
CIT_AI_PROXY=
CIT_AI_DAILY_TOKEN_CAP=200000
CIT_WEB_AI=0
